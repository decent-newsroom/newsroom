{
    "name": "decent-newsroom/signing-bundle",
    "description": "Server-side Nostr signing orchestration for extension, relay AUTH, and NIP-46 bunker flows.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\SigningBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\SigningBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "decent-newsroom/nostr-client-bundle": "@dev",
        "endroid/qr-code": "^6.0",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-redis": "*",
        "innis/nostr-core": "^0.3.17",
        "psr/log": "^3.0",
        "swentel/nostr-php": "^1.9",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/uid": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
