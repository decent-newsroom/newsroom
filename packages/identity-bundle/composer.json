{
    "name": "decent-newsroom/identity-bundle",
    "description": "Extensible multi-method identity/authentication bundle: links Nostr, email OTP, passkey and OAuth identities to a single host application user",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "decent-newsroom/nostr-kernel-bundle": "@dev",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "endroid/qr-code": "^6.0",
        "symfony/clock": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\IdentityBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\IdentityBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}