{
    "name": "decent-newsroom/relay-gateway-bundle",
    "description": "Reusable Redis-stream Nostr relay gateway built on decent-newsroom/nostr-client-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "decent-newsroom/nostr-client-bundle": "@dev",
        "ext-redis": "*",
        "innis/nostr-core": "^0.3.17",
        "psr/log": "^3.0",
        "symfony/console": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/uid": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\RelayGatewayBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\RelayGatewayBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
