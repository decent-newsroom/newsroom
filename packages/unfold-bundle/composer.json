{
    "name": "decent-newsroom/unfold-bundle",
    "description": "Reusable Symfony bundle for rendering Nostr publications on subdomains",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nostriphant/nip-19": "^2.0",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4",
        "zordius/lightncandy": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\UnfoldBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\UnfoldBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "symfony/cache": "^7.4"
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    }
}
