{% extends '@Unfold/admin/base.html.twig' %}
{% block body %}
    <h1>{{ title }}</h1>
    {% if not metadataAvailable %}<p role="status">{{ 'unfold_admin.metadata_unavailable'|trans }}</p>{% endif %}
    <dl>
        <dt>{{ 'unfold_admin.coordinate'|trans }}</dt><dd><code>{{ publication.coordinate }}</code></dd>
        <dt>{{ 'unfold_admin.owner'|trans }}</dt><dd><code>{{ publication.ownerPubkey }}</code></dd>
        <dt>{{ 'unfold_admin.theme'|trans }}</dt><dd>{{ publication.settings.theme }}</dd>
        <dt>{{ 'unfold_admin.hosting'|trans }}</dt>
        <dd>{{ publication.site ? publication.site.subdomain : 'unfold_admin.not_hosted'|trans }}</dd>
    </dl>
    {% if publication.publicUrl %}
    <nav aria-label="{{ 'unfold_admin.discovery'|trans }}">
        <a href="{{ publication.publicUrl }}/rss.xml">{{ 'unfold_admin.rss'|trans }}</a>
        <a href="{{ publication.publicUrl }}/sitemap.xml">{{ 'unfold_admin.sitemap'|trans }}</a>
    </nav>
    {% endif %}
{% endblock %}
