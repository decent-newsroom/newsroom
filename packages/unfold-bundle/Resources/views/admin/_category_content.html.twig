{% set messages = {} %}
{% for key in ['pending', 'unchanged', 'signing', 'publishing', 'wrong_signer', 'invalid_signature', 'failed', 'invalid', 'stale', 'refresh_required', 'unresolved', 'scoped', 'read_only', 'detached', 'access_denied', 'projection_failed'] %}
    {% set fullKey = 'unfold_category.' ~ key %}
    {% set messages = messages|merge({(fullKey): fullKey|trans}) %}
{% endfor %}
{% set messages = messages|merge({'unfold_content.invalid_reference': 'unfold_category.invalid'|trans}) %}
<section class="unfold-category reading-list-editor"
         data-controller="nostr--nostr-unfold-category"
         data-nostr--nostr-unfold-category-publication-value="{{ publication.coordinate }}"
         data-nostr--nostr-unfold-category-category-value="{{ categoryCoordinate }}"
         data-nostr--nostr-unfold-category-owner-value="{{ publication.ownerPubkey }}"
         data-nostr--nostr-unfold-category-prepare-url-value="{{ publication.adminPathPrefix }}/content/category/prepare"
         data-nostr--nostr-unfold-category-commit-url-value="{{ publication.adminPathPrefix }}/content/category/commit"
         data-nostr--nostr-unfold-category-csrf-token-value="{{ csrf_token('unfold_category:' ~ publication.coordinate ~ ':' ~ categoryCoordinate) }}"
         data-nostr--nostr-unfold-category-messages-value="{{ messages|json_encode|e('html_attr') }}">
    <header class="reading-list-editor__header">
        <div class="reading-list-editor__header-copy">
            <p class="eyebrow">{{ 'reading_list_editor.category_eyebrow'|trans }}</p>
            <h1>{{ categoryTitle }}</h1>
            {% if categorySummary is defined and categorySummary is not null and categorySummary != '' %}
                <p>{{ categorySummary }}</p>
            {% endif %}
            <code>{{ categoryIdentifier|default('') }}</code>
        </div>
        <div class="reading-list-editor__header-actions">
            <a class="btn btn-secondary" href="{{ publication.adminPathPrefix }}/content">{{ 'unfold_admin.content'|trans }}</a>
        </div>
    </header>
    <div class="reading-list-editor__section-heading">
        <div>
            <p class="eyebrow">{{ 'reading_list_editor.articles.eyebrow'|trans }}</p>
            <h2>{{ 'reading_list_editor.articles.title'|trans }}</h2>
        </div>
        <p>{{ 'unfold_category.help'|trans }}</p>
    </div>
    {% if readOnly %}
        <p role="status">{{ 'unfold_category.read_only'|trans }}</p>
    {% else %}
        <form class="unfold-category__add" data-mutation="add" data-action="submit->nostr--nostr-unfold-category#submit">
            <label for="category-reference">{{ 'unfold_category.reference'|trans }}</label>
            <input id="category-reference" required data-nostr--nostr-unfold-category-target="reference">
            <button class="btn btn-secondary" type="submit">{{ 'unfold_category.add'|trans }}</button>
        </form>
    {% endif %}
    <div class="reading-list-editor__collection">
        <div class="reading-list-editor__columns" aria-hidden="true">
            <span>{{ 'reading_list_editor.article.column_article'|trans }}</span>
            <span>&nbsp;</span>
        </div>
    <ol class="unfold-category__inventory reading-list-editor__articles">
        {% block category_inventory %}
        {% for item in inventory %}
            <li class="unfold-category__fallback-row">
                <h2>{{ item.title ?: (item.identifier ?: (item.coordinate ?: 'unfold_category.reference'|trans)) }}</h2>
                {% if item.kind is not null %}<p>{{ 'unfold_category.kind'|trans }} {{ item.kind }}</p>{% endif %}
                {% if item.author or item.pubkey %}
                    <p>{{ 'unfold_category.author'|trans }} {{ item.author ?: item.pubkey }}</p>
                {% endif %}
                <code>{{ item.coordinate }}</code>
                {% if item.title is null and item.reference is not null %}<p>{{ 'unfold_category.unresolved'|trans }}</p>{% endif %}
                {% if not readOnly and item.reference is not null %}
                    <form class="unfold-category__remove" data-mutation="remove" data-reference="{{ item.reference.coordinate }}" data-action="submit->nostr--nostr-unfold-category#submit">
                        <button type="submit">{{ 'unfold_category.remove'|trans }}</button>
                    </form>
                {% endif %}
            </li>
        {% else %}
            <li>{{ 'unfold_category.empty'|trans }}</li>
        {% endfor %}
        {% endblock %}
    </ol>
    </div>
    <p role="status" aria-live="polite" data-nostr--nostr-unfold-category-target="status"></p>
    {% if not readOnly %}
        <button type="button" hidden data-nostr--nostr-unfold-category-target="retry" data-action="nostr--nostr-unfold-category#retry">{{ 'unfold_category.retry'|trans }}</button>
    {% else %}
        <span hidden data-nostr--nostr-unfold-category-target="retry"></span>
    {% endif %}
</section>
