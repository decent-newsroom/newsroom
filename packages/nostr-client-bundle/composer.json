{
    "name": "decent-newsroom/nostr-client-bundle",
    "description": "Reusable Symfony bundle wrapping innis/nostr-client (AMPHP-based async Nostr relay client) for DI-friendly relay connections, subscriptions and publishing",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "innis/nostr-client": "^0.1.7",
        "innis/nostr-core": "^0.3.17",
        "psr/log": "^3.0",
        "symfony/framework-bundle": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\NostrClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\NostrClientBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
