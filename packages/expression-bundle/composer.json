{
    "name": "decent-newsroom/expression-bundle",
    "description": "Reusable Symfony bundle for Nostr expression and spell evaluation",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "innis/nostr-core": "^0.3.17",
        "innis/nostr-client": "^0.1.7",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/mercure-bundle": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\ExpressionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\ExpressionBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    }
}
