{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin_snapshot.subdomains'|trans }}{% endblock %}

{% block body %}
    <div class="analytics-container">
        <h1>{{ 'admin_snapshot.subdomains'|trans }}</h1>
        <p><a href="{{ path('admin_analytics') }}">{{ 'admin_visit_detail.back'|trans }}</a></p>
        <div class="analytics-summary-row">
            <turbo-frame id="analytics-subdomains-visits24"><p><a href="{{ path('admin_analytics_subdomains_frame', {report: 'visits24'}) }}">{{ 'admin_snapshot.load_subdomain_24h'|trans }}</a></p></turbo-frame>
            <turbo-frame id="analytics-subdomains-visits7" src="{{ path('admin_analytics_subdomains_frame', {report: 'visits7'}) }}" loading="lazy"><p>{{ 'admin_snapshot.loading'|trans }}</p></turbo-frame>
            <turbo-frame id="analytics-subdomains-unique7"><p><a href="{{ path('admin_analytics_subdomains_frame', {report: 'unique7'}) }}">{{ 'admin_snapshot.load_subdomain_unique'|trans }}</a></p></turbo-frame>
        </div>
        <turbo-frame id="analytics-subdomains-domains"><p><a href="{{ path('admin_analytics_subdomains_frame', {report: 'domains'}) }}">{{ 'admin_snapshot.load_subdomain_domains'|trans }}</a></p></turbo-frame>
        <turbo-frame id="analytics-subdomains-daily"><p><a href="{{ path('admin_analytics_subdomains_frame', {report: 'daily'}) }}">{{ 'admin_snapshot.load_subdomain_daily'|trans }}</a></p></turbo-frame>
        <turbo-frame id="analytics-subdomains-routes"><p><a href="{{ path('admin_analytics_subdomains_frame', {report: 'routes'}) }}">{{ 'admin_snapshot.load_subdomain_routes'|trans }}</a></p></turbo-frame>
        <div class="analytics-info">
            <p>{{ 'admin_snapshot.subdomain_description'|trans }}</p>
        </div>
    </div>
{% endblock %}

