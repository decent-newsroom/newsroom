{% extends 'layout.html.twig' %}

{% block title %}Administration Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/04-pages/admin-dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-dashboard">
    <div class="admin-header">
        <h1>Administration Dashboard</h1>
        <div class="admin-actions">
            <form method="post" action="{{ path('admin_dashboard_refresh') }}" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('refresh') }}">
                <button type="submit" class="btn btn-sm btn-outline-primary">Refresh</button>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notice {{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% include 'admin/_visit_snapshot.html.twig' with {snapshot: metrics.visits} only %}

    <!-- Navigation Grid -->
    <section class="metric-section">
        <h2>Tools</h2>
        <div class="nav-grid">
            <a href="{{ path('admin_analytics') }}" class="nav-card">
                <div class="nav-title">Visit Analytics</div>
                <div class="nav-description">Detailed visitor tracking and analysis</div>
            </a>
            <a href="{{ path('admin_relay_index') }}" class="nav-card">
                <div class="nav-title">Relay Management</div>
                <div class="nav-description">Monitor and manage relay</div>
            </a>
            <a href="{{ path('admin_relay_gateway') }}" class="nav-card">
                <div class="nav-title">Gateway Status</div>
                <div class="nav-description">All relays, gateway health, muting</div>
            </a>
            <a href="{{ path('admin_mercure_index') }}" class="nav-card">
                <div class="nav-title">Mercure Hub</div>
                <div class="nav-description">Real-time SSE hub diagnostics, connection test, subscriptions</div>
            </a>
            <a href="{{ path('admin_magazines') }}" class="nav-card">
                <div class="nav-title">Magazines</div>
                <div class="nav-description">Magazine administration</div>
            </a>
            <a href="{{ path('admin_roles') }}" class="nav-card">
                <div class="nav-title">User Roles</div>
                <div class="nav-description">Manage user permissions</div>
            </a>
            <a href="{{ path('admin_rss_index') }}" class="nav-card">
                <div class="nav-title">RSS Management</div>
                <div class="nav-description">Import articles from RSS feeds</div>
            </a>
            <a href="{{ path('admin_vanity_index') }}" class="nav-card">
                <div class="nav-title">Vanity Names</div>
                <div class="nav-description">Manage NIP-05 vanity names</div>
            </a>
            <a href="{{ path('admin_publication_subdomain_index') }}" class="nav-card">
                <div class="nav-title">Publication Subdomains</div>
                <div class="nav-description">Manage publication subdomain subscriptions</div>
            </a>
            <a href="{{ path('admin_unfold_index') }}" class="nav-card">
                <div class="nav-title">Unfold Sites</div>
                <div class="nav-description">Manage subdomain → magazine mappings</div>
            </a>
            <a href="{{ path('admin_feedback_index') }}" class="nav-card">
                <div class="nav-title">Feedback Messages</div>
                <div class="nav-description">View kind 24 feedback submitted via the contact form</div>
            </a>
            <a href="{{ path('admin_essayist_index') }}" class="nav-card">
                <div class="nav-title">Essayist</div>
                <div class="nav-description">Review writer candidates, manage authors and supporters</div>
            </a>
        </div>
    </section>
</div>

{% endblock %}
