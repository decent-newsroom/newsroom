{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin_snapshot.analytics_title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/04-pages/admin-dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="analytics-container">
        <h1>{{ 'admin_snapshot.analytics_title'|trans }}</h1>

        {% include 'admin/_visit_snapshot.html.twig' with {snapshot: snapshot} %}

        <div class="analytics-summary-row">
            <div class="analytics-card">
                <h2>{{ 'admin_snapshot.more_analytics'|trans }}</h2>
                <ul class="analytics-stats">
                    <li><a href="{{ path('admin_analytics_detail') }}">{{ 'admin_snapshot.detail'|trans }}</a></li>
                    <li><a href="{{ path('admin_analytics_visits_graph') }}">{{ 'admin_snapshot.visits_graph'|trans }}</a></li>
                    <li><a href="{{ path('admin_analytics_route_lookup') }}">{{ 'admin_snapshot.route_lookup'|trans }}</a></li>
                    <li><a href="{{ path('admin_analytics_bot') }}">{{ 'admin_snapshot.bots'|trans }}</a></li>
                    <li><a href="{{ path('admin_analytics_subdomains') }}">{{ 'admin_snapshot.subdomains'|trans }}</a></li>
                    <li><a href="{{ path('admin_dashboard') }}">{{ 'admin_snapshot.dashboard'|trans }}</a></li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
