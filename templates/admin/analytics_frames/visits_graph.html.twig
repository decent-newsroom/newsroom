<turbo-frame id="analytics-visits-graph">
    <div class="analytics-card">
        {% if dailyVisits|length > 0 %}
            <canvas id="visitsPerDayChart"
                    data-controller="analytics--visits-per-day-chart"
                    data-analytics--visits-per-day-chart-labels-value="{{ dailyVisits|map(stat => stat.day|date('Y-m-d'))|json_encode|e('html_attr') }}"
                    data-analytics--visits-per-day-chart-counts-value="{{ dailyVisits|map(stat => stat.count)|json_encode|e('html_attr') }}"
                    height="80"></canvas>
            <table class="analytics-table">
                <thead><tr><th>{{ 'admin_snapshot.date'|trans }}</th><th class="text-right">{{ 'admin_snapshot.visits'|trans }}</th></tr></thead>
                <tbody>
                {% for stat in dailyVisits %}
                    <tr><td>{{ stat.day|date('Y-m-d') }}</td><td class="text-right">{{ stat.count|number_format }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ 'admin_snapshot.no_visits_graph'|trans }}</p>
        {% endif %}
    </div>
</turbo-frame>


