{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin_snapshot.bots'|trans }}{% endblock %}

{% block body %}
    <div class="analytics-container">
        <h1>{{ 'admin_snapshot.bots'|trans }}</h1>
        <p><a href="{{ path('admin_analytics') }}">{{ 'admin_visit_detail.back'|trans }}</a></p>

        <turbo-frame id="analytics-bot-summary" src="{{ path('admin_analytics_bot_frame', {report: 'summary'}) }}" loading="lazy">
            <p>{{ 'admin_snapshot.loading'|trans }}</p>
        </turbo-frame>
        <turbo-frame id="analytics-bot-daily">
            <p><a href="{{ path('admin_analytics_bot_frame', {report: 'daily'}) }}">{{ 'admin_snapshot.load_bot_daily'|trans }}</a></p>
        </turbo-frame>
        <turbo-frame id="analytics-bot-agents">
            <p><a href="{{ path('admin_analytics_bot_frame', {report: 'agents'}) }}">{{ 'admin_snapshot.load_bot_agents'|trans }}</a></p>
        </turbo-frame>
        <div class="analytics-info">
            <p>{{ 'admin_snapshot.bot_description'|trans }}</p>
        </div>
    </div>
{% endblock %}

{% block aside %}{% endblock %}
