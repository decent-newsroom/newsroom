{% extends 'layout.html.twig' %}

{% block title %}{{ 'unfold_setup.edit_title'|trans({'%subdomain%': site.subdomain}) }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">{{ 'unfold_setup.edit_heading'|trans }}</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">{{ 'unfold_setup.site_configuration'|trans }}</h5>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_unfold_edit', {id: site.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_unfold_edit' ~ site.id) }}">

                <div class="mb-3">
                    <label for="subdomain" class="form-label">{{ 'unfold_setup.subdomain'|trans }}</label>
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               id="subdomain"
                               name="subdomain"
                               value="{{ site.subdomain }}"
                               pattern="[a-z0-9\-]+"
                               required>
                        <span class="input-group-text">.{{ app.request.host }}</span>
                    </div>
                    <div class="form-text">{{ 'unfold_setup.subdomain_edit_help'|trans }}</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="coordinate">{{ 'unfold_setup.coordinate'|trans }}</label>
                    <div class="form-control" id="coordinate" aria-readonly="true" role="textbox">{{ site.coordinate }}</div>
                    <div class="form-text">{{ 'unfold_setup.immutable_coordinate'|trans }}</div>
                </div>

                <div class="mb-4">
                    <label for="theme" class="form-label">{{ 'unfold_setup.theme'|trans }}</label>
                    <select class="form-select" id="theme" name="theme">
                        {% for theme in themes %}
                            <option value="{{ theme }}" {{ theme == selectedTheme ? 'selected' : '' }}>{{ theme|capitalize }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ 'unfold_setup.theme_help'|trans }}</div>
                </div>

                <div class="mb-4">
                    <h6>{{ 'unfold_setup.site_info'|trans }}</h6>
                    <div class="text-muted small">
                        <p class="mb-1"><strong>{{ 'unfold_setup.created_at'|trans }}:</strong> {{ site.createdAt|date('F j, Y \\a\\t g:i a') }}</p>
                        <p class="mb-0"><strong>{{ 'unfold_setup.updated_at'|trans }}:</strong> {{ site.updatedAt|date('F j, Y \\a\\t g:i a') }}</p>
                    </div>
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary">{{ 'unfold_setup.save'|trans }}</button>
                    <a href="{{ path('admin_unfold_index') }}" class="btn btn-outline-secondary">{{ 'unfold_setup.cancel'|trans }}</a>
                    <a href="http://{{ site.subdomain }}.{{ app.request.host }}" target="_blank" class="btn btn-outline-info ms-auto">{{ 'unfold_setup.visit_site'|trans }}</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-4 border-danger">
        <div class="card-header">
            <h5 class="mb-0">{{ 'unfold_setup.danger_zone'|trans }}</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">{{ 'unfold_setup.delete_warning'|trans }}</p>
            <form action="{{ path('admin_unfold_delete', {id: site.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ site.id) }}">
                <button type="submit" class="btn btn-outline-danger">{{ 'unfold_setup.delete'|trans }}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block aside %}
<nav aria-label="{{ 'unfold_setup.breadcrumb_label'|trans }}">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_unfold_index') }}">{{ 'unfold_setup.sites'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'unfold_setup.edit_breadcrumb'|trans({'%subdomain%': site.subdomain}) }}</li>
    </ol>
</nav>
{% endblock %}

