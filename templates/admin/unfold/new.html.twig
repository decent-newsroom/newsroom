{% extends 'layout.html.twig' %}

{% block title %}{{ 'unfold_setup.new_title'|trans }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">{{ 'unfold_setup.new_heading'|trans }}</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">{{ 'unfold_setup.site_configuration'|trans }}</h5>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_unfold_create') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_unfold_create') }}">

                <div class="mb-4">
                    <label for="subdomain" class="form-label">{{ 'unfold_setup.subdomain'|trans }} <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               id="subdomain"
                               name="subdomain"
                               placeholder="{{ 'unfold_setup.subdomain_placeholder'|trans }}"
                               pattern="[a-z0-9\-]+"
                               required>
                        <span class="input-group-text">.{{ app.request.host }}</span>
                    </div>
                    <div class="form-text">{{ 'unfold_setup.subdomain_help'|trans }}</div>
                </div>

                <div class="mb-4">
                    <label for="coordinate" class="form-label">{{ 'unfold_setup.coordinate'|trans }} <span class="text-danger">*</span></label>
                    {% if magazines is not empty %}
                        <select class="form-select" id="coordinate" name="coordinate" required>
                            <option value="">{{ 'unfold_setup.choose_magazine'|trans }}</option>
                            {% for magazine in magazines %}
                                <option value="{{ magazine.coordinate }}">{{ magazine.title }} ({{ magazine.slug }})</option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <div class="alert alert-warning" role="alert">{{ 'unfold_setup.no_magazines'|trans }}</div>
                    {% endif %}
                </div>

                <div class="mb-4">
                    <label for="theme" class="form-label">{{ 'unfold_setup.theme'|trans }}</label>
                    <select class="form-select" id="theme" name="theme">
                        {% for theme in themes %}
                            <option value="{{ theme }}">{{ theme|capitalize }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ 'unfold_setup.theme_help'|trans }}</div>
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary">{{ 'unfold_setup.create'|trans }}</button>
                    <a href="{{ path('admin_unfold_index') }}" class="btn btn-outline-secondary">{{ 'unfold_setup.cancel'|trans }}</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block aside %}
<nav aria-label="{{ 'unfold_setup.breadcrumb_label'|trans }}">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_unfold_index') }}">{{ 'unfold_setup.sites'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ 'unfold_setup.new_breadcrumb'|trans }}</li>
    </ol>
</nav>
{% endblock %}

