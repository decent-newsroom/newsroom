{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin_visit_detail.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/04-pages/admin-dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="analytics-container">
        <h1>{{ 'admin_visit_detail.title'|trans }}</h1>
        <p><a href="{{ path('admin_analytics') }}">{{ 'admin_visit_detail.back'|trans }}</a></p>
        <p>{{ 'admin_visit_detail.intro'|trans }}</p>
        <p>{{ 'admin_visit_detail.sample_note'|trans }}</p>

        <div class="analytics-summary-row">
            <div class="analytics-card">
                <h2>{{ 'admin_visit_detail.visits_title'|trans }}</h2>
                <turbo-frame id="analytics-detail-visits" src="{{ path('admin_analytics_detail_metric', {metric: 'visits'}) }}" loading="lazy">
                    <p>{{ 'admin_visit_detail.loading_visits'|trans }}</p>
                </turbo-frame>
            </div>
            <div class="analytics-card">
                <h2>{{ 'admin_visit_detail.visitors_title'|trans }}</h2>
                <turbo-frame id="analytics-detail-visitors" src="{{ path('admin_analytics_detail_metric', {metric: 'visitors'}) }}" loading="lazy">
                    <p>{{ 'admin_visit_detail.loading_visitors'|trans }}</p>
                </turbo-frame>
            </div>
        </div>

        <div class="analytics-summary-row">
            <div class="analytics-card">
                <h2>{{ 'admin_visit_detail.average_title'|trans }}</h2>
                <turbo-frame id="analytics-detail-average">
                    <a href="{{ path('admin_analytics_detail_metric', {metric: 'average'}) }}">{{ 'admin_visit_detail.load_average'|trans }}</a>
                </turbo-frame>
            </div>
            <div class="analytics-card">
                <h2>{{ 'admin_visit_detail.bounce_title'|trans }}</h2>
                <turbo-frame id="analytics-detail-bounce">
                    <a href="{{ path('admin_analytics_detail_metric', {metric: 'bounce'}) }}">{{ 'admin_visit_detail.load_bounce'|trans }}</a>
                </turbo-frame>
                <p class="analytics-note">{{ 'admin_visit_detail.bounce_note'|trans }}</p>
            </div>
        </div>

        <div class="analytics-card">
            <h2>{{ 'admin_visit_detail.sessions_title'|trans }}</h2>
            <p>{{ 'admin_visit_detail.sessions_note'|trans }}</p>
            <turbo-frame id="analytics-detail-sessions">
                <a href="{{ path('admin_analytics_detail_metric', {metric: 'sessions'}) }}">{{ 'admin_visit_detail.load_sessions'|trans }}</a>
            </turbo-frame>
        </div>
    </div>
{% endblock %}
