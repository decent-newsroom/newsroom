{# Generic event metadata block.
   Surfaces common Nostr tags that repeat across many event kinds, including
   tags from newer or unknown kinds that do not have a dedicated renderer yet. #}
{% set metaAlt = null %}
{% set metaSummary = null %}
{% set metaPublishedAt = null %}
{% set metaClient = null %}
{% set metaTopics = [] %}
{% set metaMentions = [] %}
{% set metaReferences = [] %}
{% set metaSources = [] %}
{% set seenReferences = [] %}
{% set seenSources = [] %}

{% for tag in event.tags %}
    {% if tag is iterable and tag[0] is defined %}
        {% set tagName = tag[0] %}
        {% set tagValue = tag[1] ?? null %}

        {% if tagName == 'alt' and metaAlt is null and tagValue %}
            {% set metaAlt = tagValue %}
        {% elseif tagName == 'summary' and metaSummary is null and tagValue %}
            {% set metaSummary = tagValue %}
        {% elseif tagName == 'published_at' and metaPublishedAt is null and tagValue %}
            {% set metaPublishedAt = tagValue %}
        {% elseif tagName == 'client' and metaClient is null and tagValue %}
            {% set metaClient = tagValue %}
        {% elseif tagName == 't' and tagValue and tagValue not in metaTopics %}
            {% set metaTopics = metaTopics|merge([tagValue]) %}
        {% elseif tagName == 'p' and tagValue and tagValue|length == 64 and tagValue not in metaMentions %}
            {% set metaMentions = metaMentions|merge([tagValue]) %}
        {% elseif tagName in ['a', 'A', 'e', 'E', 'q'] and tagValue %}
            {% set refKey = tagName ~ ':' ~ tagValue %}
            {% if refKey not in seenReferences %}
                {% set refType = 'event' %}
                {% if tagName in ['a', 'A'] %}
                    {% set refType = 'address' %}
                {% endif %}

                {% set seenReferences = seenReferences|merge([refKey]) %}
                {% set metaReferences = metaReferences|merge([{
                    tag: tagName,
                    type: refType,
                    value: tagValue,
                    relay: tag[2] ?? null,
                    pubkey: tag[3] ?? null
                }]) %}
            {% endif %}
        {% elseif tagName == 'r' and tagValue and tagValue matches '#^https?://#i' %}
            {% if tagValue not in seenSources %}
                {% set seenSources = seenSources|merge([tagValue]) %}
                {% set metaSources = metaSources|merge([{
                    url: tagValue,
                    relation: tag[2] ?? null
                }]) %}
            {% endif %}
        {% endif %}
    {% endif %}
{% endfor %}



{% set hasAnyMeta = metaAlt or metaSummary or metaPublishedAt or metaClient
                   or metaTopics|length > 0 or metaMentions|length > 0
                   or metaReferences|length > 0 or metaSources|length > 0 %}

{% if hasAnyMeta %}
<section class="event-meta-block" aria-label="{{ 'event.details'|trans }}">
    {% if metaSummary %}
        <p class="event-meta-summary lede">{{ metaSummary }}</p>
    {% endif %}

    {% if metaAlt and (event.content is empty or event.content|length < 5) %}
        <p class="event-meta-alt"><em>{{ metaAlt }}</em></p>
    {% endif %}

    {% if metaTopics|length > 0 %}
        <div class="event-meta-topics">
            <small class="event-meta-label">{{ 'nav.topics'|trans }}:</small>
            {% for t in metaTopics|slice(0, 20) %}
                <a href="{{ path('topics', {'tag': t}) }}" class="badge bg-secondary">#{{ t }}</a>
            {% endfor %}
        </div>
    {% endif %}

    {% if metaMentions|length > 0 %}
        <div class="event-meta-mentions">
            <small class="event-meta-label">{{ 'event.mentions'|trans }}:</small>
            {% for pk in metaMentions|slice(0, 10) %}
                <a href="{{ path('author-redirect', {'pubkey': pk}) }}">
                    <twig:Molecules:UserFromNpub :ident="pk" />
                </a>{% if not loop.last %}, {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {% if metaReferences|length > 0 %}
        <div class="event-meta-references">
            <small class="event-meta-label">{{ 'event.references'|trans }}:</small>
            <ul class="event-meta-list">
                {% for ref in metaReferences|slice(0, 12) %}
                    <li>
                        <span class="event-meta-tag-name">{{ ref.tag }}</span>
                        {% if ref.type == 'event' and ref.value matches '/^[0-9a-f]{64}$/i' %}
                            <a href="{{ path('nevent', {'nevent': ref.value|nEncode}) }}"><code>{{ ref.value|slice(0, 12) }}...{{ ref.value|slice(-8) }}</code></a>
                        {% else %}
                            <code>{{ ref.value }}</code>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if metaSources|length > 0 %}
        <div class="event-meta-sources">
            <small class="event-meta-label">{{ 'text.source'|trans }}:</small>
            <ul class="event-meta-list">
                {% for source in metaSources|slice(0, 8) %}
                    <li>
                        <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.url }}</a>
                        {% if source.relation %}<small>({{ source.relation }})</small>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if metaPublishedAt or metaClient or (metaAlt and not (event.content is empty or event.content|length < 5)) %}
        <dl class="event-meta-extra">
            {% if metaPublishedAt %}
                <dt><small>{{ 'text.published'|trans }}:</small></dt>
                <dd><small>{{ metaPublishedAt|date('F j, Y H:i') }}</small></dd>
            {% endif %}
            {% if metaClient %}
                <dt><small>{{ 'event.client'|trans }}:</small></dt>
                <dd><small>{{ metaClient }}</small></dd>
            {% endif %}
        </dl>
    {% endif %}
</section>
{% endif %}