{# NIP-22 Comment (kind 1111)
   Renders the root / parent reference as a card above the comment
   content so that readers can see what is being commented on.

   Per NIP-22, the root-scope is carried in uppercase tags:
     ["E", <event-id>, <relay>, <pubkey>]        – root is a plain event
     ["A", "<kind>:<pubkey>:<d>", <relay>]        – root is addressable
     ["I", <identity>]                            – root is an external identity
     ["K", "<kind>"]                              – root kind (hint)
     ["P", <pubkey>]                              – root author
   The direct parent uses the lowercase equivalents (e / a / i / k / p).
#}

{# ── Extract root-scope refs ───────────────────────────────────── #}
{% set rootReferenceType = null %}
{% set rootReferenceValue = null %}
{% set rootKind = null %}
{% set rootAuthor = null %}
{% set rootARelay = null %}

{# ── Extract direct-parent refs ────────────────────────────────── #}
{% set parentE = null %}
{% set parentA = null %}
{% set parentI = null %}
{% set hasParentA = false %}
{% set hasParentE = false %}
{% set hasParentI = false %}
{% set parentKind = null %}
{% set parentAuthor = null %}
{% set parentARelay = null %}

{% for tag in event.tags %}
    {% if tag[0] in ['A', 'E', 'I'] and rootReferenceType is null %}
        {% set rootReferenceType = tag[0]|lower %}
        {% set rootReferenceValue = tag[1] is defined ? tag[1] : null %}
        {% if tag[0] == 'A' and tag[2] is defined %}{% set rootARelay = tag[2] %}{% endif %}
    {% endif %}
    {% if tag[0] == 'K' and rootKind is null and tag[1] is defined %}{% set rootKind = tag[1] %}{% endif %}
    {% if tag[0] == 'P' and rootAuthor is null and tag[1] is defined %}{% set rootAuthor = tag[1] %}{% endif %}

    {% if tag[0] == 'e' and not hasParentE %}
        {% set hasParentE = true %}
        {% set parentE = tag[1] is defined ? tag[1] : null %}
    {% endif %}
    {% if tag[0] == 'a' and not hasParentA %}
        {% set hasParentA = true %}
        {% set parentA = tag[1] is defined ? tag[1] : null %}
        {% if tag[2] is defined %}{% set parentARelay = tag[2] %}{% endif %}
    {% endif %}
    {% if tag[0] == 'i' and not hasParentI %}
        {% set hasParentI = true %}
        {% set parentI = tag[1] is defined ? tag[1] : null %}
    {% endif %}
    {% if tag[0] == 'k' and parentKind is null and tag[1] is defined %}{% set parentKind = tag[1] %}{% endif %}
    {% if tag[0] == 'p' and parentAuthor is null and tag[1] is defined %}{% set parentAuthor = tag[1] %}{% endif %}
{% endfor %}

{% set parentReferenceType = hasParentA ? 'a' : (hasParentE ? 'e' : (hasParentI ? 'i' : null)) %}
{% set parentReferenceValue = parentReferenceType == 'a' ? parentA : (parentReferenceType == 'e' ? parentE : parentI) %}

{# Is the parent the same event as the root? (avoid rendering two identical cards) #}
{% set parentIsRoot = rootReferenceType == parentReferenceType
                      and parentReferenceValue is not null
                      and parentReferenceValue == rootReferenceValue %}

{# ── "Replying to" – direct parent ─────────────────────────────── #}
{% if parentReferenceType is not null %}
    <div class="comment-parent" aria-label="Replying to">
        <div class="comment-parent-label">
            <small>Replying to{% if parentKind %} <span class="badge bg-secondary">kind {{ parentKind }}</span>{% endif %}</small>
        </div>
        {% if not (parentReferenceValue|isValidNostrReferenceValue) %}
            <div class="nostr-placeholder">
                <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
            </div>
        {% elseif parentReferenceType == 'a' %}
            {% set parentAddress = parentA|naddrEncodeCoordinateOrNull(parentARelay) %}
            {% if parentAddress is not null %}
                <twig:Molecules:NostrEmbed :bech="parentAddress" type="naddr" />
            {% else %}
                <div class="nostr-placeholder">
                    <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
                </div>
            {% endif %}
        {% elseif parentReferenceType == 'e' %}
            <twig:Molecules:NostrEmbed :bech="parentE|nEncode" type="note" />
        {% elseif parentReferenceType == 'i' %}
            {% if parentI|isSafeExternalNostrReference %}
                <twig:Molecules:WebPreview :url="parentI" />
            {% else %}
                <div class="comment-parent-external">
                    {{ parentI }}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endif %}

{# ── Comment content ───────────────────────────────────────────── #}
<div class="event-content comment-content">
    <twig:Atoms:Content :content="event.content" />
</div>
{% include 'partial/_gallery.html.twig' with {event: event, isEmbed: false} %}

{# ── "In thread" – root, only if different from the parent ─────── #}
{% if not parentIsRoot and rootReferenceType is not null %}
    <div class="comment-root" aria-label="In thread">
        <div class="comment-root-label">
            <small>In thread{% if rootKind %} <span class="badge bg-secondary">kind {{ rootKind }}</span>{% endif %}</small>
        </div>
        {% if not (rootReferenceValue|isValidNostrReferenceValue) %}
            <div class="nostr-placeholder">
                <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
            </div>
        {% elseif rootReferenceType == 'a' %}
            {% set rootAddress = rootReferenceValue|naddrEncodeCoordinateOrNull(rootARelay) %}
            {% if rootAddress is not null %}
                <twig:Molecules:NostrEmbed :bech="rootAddress" type="naddr" />
            {% else %}
                <div class="nostr-placeholder">
                    <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
                </div>
            {% endif %}
        {% elseif rootReferenceType == 'e' %}
            <twig:Molecules:NostrEmbed :bech="rootReferenceValue|nEncode" type="note" />
        {% elseif rootReferenceType == 'i' %}
            {% if rootReferenceValue|isSafeExternalNostrReference %}
                <twig:Molecules:WebPreview :url="rootReferenceValue" />
            {% else %}
                <div class="comment-root-external">
                    {{ rootReferenceValue }}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endif %}
