<turbo-frame id="profile-tab-content">
    <div class="profile-editorial-content">
        {# Magazines Section #}
        {% if authorMagazines|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for item in authorMagazines %}
                        {% set magSlug = item.slug|default(null) %}
                        {% if magSlug %}
                            <article class="card article-card reading-list-card{% if not item.image|default(null) %} article-card--text-only{% endif %}">
                                <div class="article-card__body">
                                    <div class="article-card__content">
                                        <div class="metadata">
                                              <span>
                                                  {{ 'text.by'|trans }}
                                                  {% if item.author is defined and item.author %}
                                                      {{ item.author }}
                                                  {% else %}
                                                      <twig:Molecules:UserFromNpub :ident="item.pubkey" />
                                                  {% endif %}
                                              </span>
                                            <span>
                                                <time datetime="{{ item.createdAt|date('c') }}">{{ item.createdAt|date('M j, Y') }}</time>
                                            </span>
                                        </div>

                                        <div class="card-sources reading-list-card__sources">
                                            <span class="source-badge source-badge--category">Magazine</span>
                                        </div>

                                        <h2 class="card-title line-clamp-5">
                                            <a class="article-card__title-link" href="{{ path('magazine-index', {mag: magSlug}) }}" data-turbo-frame="_top">{{ item.title }}</a>
                                        </h2>

                                        {% if item.summary is defined and item.summary %}
                                            <p class="lede line-clamp-5">{{ item.summary }}</p>
                                        {% endif %}
                                    </div>

                                    {% if item.image|default(null) %}
                                        <figure class="article-card__media reading-list-card__media">
                                            <img
                                                src="{{ item.image }}"
                                                alt="{{ 'card.coverImageAlt'|trans({'%title%': item.title}) }}"
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        </figure>
                                    {% endif %}
                                </div>
                            </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Featured in Magazines Section #}
        {% if featuredMagazines|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for item in featuredMagazines %}
                        {% set magSlug = item.slug|default(null) %}
                        {% if magSlug %}
                            <article class="card article-card reading-list-card{% if not item.image|default(null) %} article-card--text-only{% endif %}">
                                <div class="article-card__body">
                                    <div class="article-card__content">
                                        <div class="metadata">
                                              <span>
                                                  {{ 'text.by'|trans }}
                                                  {% if item.author is defined and item.author %}
                                                      {{ item.author }}
                                                  {% else %}
                                                      <twig:Molecules:UserFromNpub :ident="item.pubkey" />
                                                  {% endif %}
                                              </span>
                                            <span>
                                                <time datetime="{{ item.createdAt|date('c') }}">{{ item.createdAt|date('M j, Y') }}</time>
                                            </span>
                                        </div>

                                        <div class="card-sources reading-list-card__sources">
                                            <span class="source-badge source-badge--category">Featured in</span>
                                        </div>

                                        <h2 class="card-title line-clamp-5">
                                            <a class="article-card__title-link" href="{{ path('magazine-index', {mag: magSlug}) }}" data-turbo-frame="_top">{{ item.title }}</a>
                                        </h2>

                                        {% if item.summary is defined and item.summary %}
                                            <p class="lede line-clamp-5">{{ item.summary }}</p>
                                        {% endif %}
                                    </div>

                                    {% if item.image|default(null) %}
                                        <figure class="article-card__media reading-list-card__media">
                                            <img
                                                src="{{ item.image }}"
                                                alt="{{ 'card.coverImageAlt'|trans({'%title%': item.title}) }}"
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        </figure>
                                    {% endif %}
                                </div>
                            </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Reading Lists Section #}
        {% if authorReadingLists|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for item in authorReadingLists %}
                        {% set listSlug = item.slug|default(null) %}
                        {% if listSlug %}
                            <article class="card article-card reading-list-card{% if not item.image|default(null) %} article-card--text-only{% endif %}">
                                <div class="article-card__body">
                                    <div class="article-card__content">
                                        <div class="metadata">
                                            <span>
                                                {{ 'text.by'|trans }}
                                                <twig:Molecules:UserFromNpub :ident="item.pubkey" />
                                            </span>
                                            {% if item.createdAt is defined and item.createdAt %}
                                                <span>
                                                    <time datetime="{{ item.createdAt|date('c') }}">{{ item.createdAt|date('M j, Y') }}</time>
                                                </span>
                                            {% endif %}
                                        </div>

                                        <div class="card-sources reading-list-card__sources">
                                            <span class="source-badge source-badge--category">Reading list</span>
                                        </div>

                                        <h2 class="card-title line-clamp-5">
                                            <a class="article-card__title-link" href="{{ path('reading-list', {npub: item.pubkey|hex_to_npub, slug: listSlug}) }}" data-turbo-frame="_top">{{ item.title }}</a>
                                        </h2>

                                        {% if item.summary is defined and item.summary %}
                                            <p class="lede line-clamp-5">{{ item.summary }}</p>
                                        {% endif %}
                                    </div>

                                    {% if item.image|default(null) %}
                                        <figure class="article-card__media reading-list-card__media">
                                            <img
                                                src="{{ item.image }}"
                                                alt="{{ 'card.coverImageAlt'|trans({'%title%': item.title}) }}"
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        </figure>
                                    {% endif %}
                                </div>
                            </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Featured in Reading Lists Section #}
        {% if featuredReadingLists|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for item in featuredReadingLists %}
                        {% set listSlug = item.slug|default(null) %}
                        {% if listSlug %}
                            <article class="card article-card reading-list-card{% if not item.image|default(null) %} article-card--text-only{% endif %}">
                                <div class="article-card__body">
                                    <div class="article-card__content">
                                        <div class="metadata">
                                            <span>
                                                {{ 'text.by'|trans }}
                                                <twig:Molecules:UserFromNpub :ident="item.pubkey" />
                                            </span>
                                            {% if item.createdAt is defined and item.createdAt %}
                                                <span>
                                                    <time datetime="{{ item.createdAt|date('c') }}">{{ item.createdAt|date('M j, Y') }}</time>
                                                </span>
                                            {% endif %}
                                        </div>

                                        <div class="card-sources reading-list-card__sources">
                                            <span class="source-badge source-badge--category">Featured in</span>
                                            <span class="source-badge source-badge--category">Reading list</span>
                                        </div>

                                        <h2 class="card-title line-clamp-5">
                                            <a class="article-card__title-link" href="{{ path('reading-list', {npub: item.pubkey|hex_to_npub, slug: listSlug}) }}" data-turbo-frame="_top">{{ item.title }}</a>
                                        </h2>

                                        {% if item.summary is defined and item.summary %}
                                            <p class="lede line-clamp-5">{{ item.summary }}</p>
                                        {% endif %}
                                    </div>

                                    {% if item.image|default(null) %}
                                        <figure class="article-card__media reading-list-card__media">
                                            <img
                                                src="{{ item.image }}"
                                                alt="{{ 'card.coverImageAlt'|trans({'%title%': item.title}) }}"
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        </figure>
                                    {% endif %}
                                </div>
                            </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Follow Packs Section #}
        {% if existingFollowPacks|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for pack in existingFollowPacks %}
                        <article class="card article-card follow-pack-card{% if not pack.image %} article-card--text-only{% endif %}">
                            <div class="article-card__body">
                                <div class="article-card__content">
                                    <div class="metadata">
                                        <span>{{ 'followPacks.curatedBy'|trans }} <twig:Molecules:UserFromNpub :ident="pack.pubkey" /></span>
                                        {% if pack.createdAt is defined and pack.createdAt %}
                                            <span><time datetime="{{ pack.createdAt|date('c') }}">{{ pack.createdAt|date('M j, Y') }}</time></span>
                                        {% endif %}
                                    </div>

                                    <div class="card-sources follow-pack-card__sources">
                                        <span class="source-badge source-badge--category">{{ 'followPacks.type'|trans }}</span>
                                        <span class="source-badge">{{ pack.memberCount }} {{ 'followPacks.writers'|trans }}</span>
                                    </div>

                                    <h2 class="card-title line-clamp-5">
                                        <a class="article-card__title-link" href="{{ path('follow_pack_view', { npub: pack.pubkey|hex_to_npub, dtag: pack.dTag }) }}" data-turbo-frame="_top">
                                            {{ pack.title ?? pack.dTag }}
                                        </a>
                                    </h2>

                                    {% if pack.description %}
                                        <p class="lede line-clamp-3">{{ pack.description }}</p>
                                    {% endif %}
                                </div>

                                {% if pack.image %}
                                    <figure class="article-card__media follow-pack-card__media">
                                        <img
                                            src="{{ pack.image }}"
                                            alt="{{ 'card.coverImageAlt'|trans({'%title%': pack.title ?? pack.dTag}) }}"
                                            loading="lazy"
                                            decoding="async"
                                        >
                                    </figure>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Featured in Follow Packs Section #}
        {% if featuredInFollowPacks|default([])|length > 0 %}
            <div class="overview-section">
                <div class="w-container">
                    {% for pack in featuredInFollowPacks %}
                        <article class="card article-card follow-pack-card{% if not pack.image %} article-card--text-only{% endif %}">
                            <div class="article-card__body">
                                <div class="article-card__content">
                                    <div class="metadata">
                                        <span>{{ 'followPacks.curatedBy'|trans }} <twig:Molecules:UserFromNpub :ident="pack.pubkey" /></span>
                                        {% if pack.createdAt is defined and pack.createdAt %}
                                            <span><time datetime="{{ pack.createdAt|date('c') }}">{{ pack.createdAt|date('M j, Y') }}</time></span>
                                        {% endif %}
                                    </div>

                                    <div class="card-sources follow-pack-card__sources">
                                        <span class="source-badge source-badge--category">Featured in</span>
                                        <span class="source-badge source-badge--category">{{ 'followPacks.type'|trans }}</span>
                                        <span class="source-badge">{{ pack.memberCount }} {{ 'followPacks.writers'|trans }}</span>
                                    </div>

                                    <h2 class="card-title line-clamp-5">
                                        <a class="article-card__title-link" href="{{ path('follow_pack_view', { npub: pack.pubkey|hex_to_npub, dtag: pack.dTag }) }}" data-turbo-frame="_top">
                                            {{ pack.title ?? pack.dTag }}
                                        </a>
                                    </h2>

                                    {% if pack.description %}
                                        <p class="lede line-clamp-3">{{ pack.description }}</p>
                                    {% endif %}
                                </div>

                                {% if pack.image %}
                                    <figure class="article-card__media follow-pack-card__media">
                                        <img
                                            src="{{ pack.image }}"
                                            alt="{{ 'card.coverImageAlt'|trans({'%title%': pack.title ?? pack.dTag}) }}"
                                            loading="lazy"
                                            decoding="async"
                                        >
                                    </figure>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Empty state #}
        {% if authorMagazines|default([])|length == 0 and existingFollowPacks|default([])|length == 0 and featuredMagazines|default([])|length == 0 and featuredInFollowPacks|default([])|length == 0 and authorReadingLists|default([])|length == 0 and featuredReadingLists|default([])|length == 0 %}
            <div class="no-content">
                {% if isOwner|default(false) %}
                    <p>You are not publishing or featured in magazines or follow packs yet.</p>
                    <p>
                        <a href="{{ path('editor-create') }}" class="btn btn-primary" data-turbo-frame="_top">Create a magazine</a>
                    </p>
                {% else %}
                    <p>This author is not publishing or featured in magazines, reading lists, or follow packs yet.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</turbo-frame>
