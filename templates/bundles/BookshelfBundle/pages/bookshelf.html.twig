{% extends '@Bookshelf/bookshelf-layout.html.twig' %}

{% block title %}{{ 'bookshelf.app.title'|trans }} | Decent Newsroom{% endblock %}

{% block ogtags %}
    <meta name="turbo-cache-control" content="no-cache">
    <meta property="og:title" content="{{ 'bookshelf.app.title'|trans }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url('bookshelf') }}">
    <meta property="og:description" content="{{ 'bookshelf.promo.description'|trans }}">
    <script type="application/ld+json">
    {{ {
        '@context': 'https://schema.org',
        '@type': 'MobileApplication',
        name: 'Bookshelf',
        operatingSystem: 'Android',
        applicationCategory: 'BooksApplication',
        description: 'bookshelf.promo.description'|trans,
        url: url('bookshelf'),
        downloadUrl: 'https://zapstore.dev/apps/eu.decentnewsroom.bookshelf'
    }|json_encode(15)|raw }}
    </script>
{% endblock %}

{% block body %}
    <div class="bookshelf-page bookshelf-landing">
        {{ include('partial/_bookshelf_app.html.twig') }}
        {% if featured.state != 'unconfigured' %}
            <section class="bookshelf-featured" aria-labelledby="bookshelf-featured-heading">
                <header class="bookshelf-section-heading">
                    <div>
                        <p class="eyebrow">{{ 'bookshelf.promo.curated_eyebrow'|trans }}</p>
                        <h2 id="bookshelf-featured-heading">{{ 'bookshelf.promo.curated_title'|trans }}</h2>
                    </div>
                    {% if featured.eventId %}
                        <a href="{{ path('bookshelf_featured', {eventId: featured.eventId}) }}">{{ 'bookshelf.promo.view_directory'|trans }}</a>
                    {% endif %}
                </header>
                {% include 'bookshelf/_featured_entries.html.twig' with {featured: featured} only %}
            </section>
        {% endif %}
        {% include 'bookshelf/_landing_search.html.twig' %}
    </div>
{% endblock %}

{% block aside %}{% endblock %}
