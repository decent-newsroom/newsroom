{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <div class="author-stats">
        <h1>{{ 'nav.myStats'|trans }}</h1>

        <h2>{{ 'stats.thisWeek'|trans }}</h2>
        {% include 'stats/_frame.html.twig' with {frameId: 'stats-week', route: 'profile_stats_week', loading: 'eager'} only %}

        <h2>{{ 'stats.last30Days'|trans }}</h2>
        {% include 'stats/_frame.html.twig' with {frameId: 'stats-month', route: 'profile_stats_month', loading: 'lazy'} only %}

        {% include 'stats/_frame.html.twig' with {frameId: 'stats-chart', route: 'profile_stats_chart', loading: 'lazy'} only %}
    </div>
{% endblock %}