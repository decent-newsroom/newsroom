<div class="content-stream">
    {% for row in rows %}
        {% set item = row.item %}
        <div class="content-stream__entry" data-stream-key="{{ row.key }}">
            <div class="content-stream__type">
                <span>{{ ('content_stream.type.' ~ (row.type == 'activity' ? item.type : row.type))|trans }}</span>
                {% for label in row.labels %}<span>{{ label|trans }}</span>{% endfor %}
            </div>
            {% if row.type in ['article', 'draft'] %}
                {% set coord = item.pubkey ~ ':' ~ item.slug %}
                <twig:Molecules:Card :article="item" :authors_metadata="authorsMetadata|default([])"
                    :comment_count="commentCounts[coord]|default(0)" :source_labels="sourceLabels[coord]|default([])" />
            {% elseif row.type == 'activity' %}
                {% include 'partial/_activity_items.html.twig' with {activityItems: [item]} %}
            {% elseif row.type == 'highlight' %}
                {% if item.created_at is defined %}
                    {% include 'partial/_highlight_feed_card.html.twig' with {highlight: item} %}
                {% else %}
                    {% include 'partial/_highlight_with_source.html.twig' with {highlight: item} %}
                {% endif %}
            {% elseif row.type == 'media' %}
                <article class="stream-media">
                    {% if item.kind == 20 %}
                        <twig:Molecules:PictureGallery :tags="item.tags" :content="item.content|default('')"
                            :eventUrl="path('nevent', {nevent: item.noteId})" :creditPubkey="item.pubkey" />
                    {% else %}
                        <figure class="media">
                            {% include 'partial/_masonry.html.twig' with {mediaEvents: [item]} %}
                            {% if item.content %}<figcaption class="picture-description"><twig:Atoms:Content :content="item.content" :renderMedia="false" /></figcaption>{% endif %}
                        </figure>
                    {% endif %}
                    <footer class="stream-media__meta">
                        <a href="{{ path('nevent', {nevent: item.noteId}) }}" data-turbo-frame="_top">{{ 'content_stream.open_media'|trans }}</a>
                        <time datetime="{{ row.timestamp|date('c') }}">{{ row.timestamp|date('M j, Y') }}</time>
                    </footer>
                </article>
            {% elseif row.type == 'update' %}
                {% include 'partial/_update_items.html.twig' with {updates: [item]} %}
            {% else %}
                {% include 'content_stream/_collection.html.twig' %}
            {% endif %}
        </div>
        {% if feedBreaks[loop.index] is defined %}
            <twig:Organisms:FeaturedWritersCarousel :members="feedBreaks[loop.index]"
                :packNpub="featuredPeople.packNpub" :packDtag="featuredPeople.packDtag" :personal="featuredPeople.personal" :breakId="loop.index" />
        {% endif %}
    {% else %}
        <div class="stream-empty">
            <h2>{{ 'content_stream.empty_title'|trans }}</h2>
            <p>{{ 'content_stream.empty_description'|trans }}</p>
        </div>
        {% if feedBreaks[0] is defined %}
            <twig:Organisms:FeaturedWritersCarousel :members="feedBreaks[0]"
                :packNpub="featuredPeople.packNpub" :packDtag="featuredPeople.packDtag" :personal="featuredPeople.personal" :breakId="0" />
        {% endif %}
    {% endfor %}
</div>
