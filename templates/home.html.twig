{% extends 'layout.html.twig' %}

{% block title %}{{ 'nav.discover'|trans }} — {{ brand_name }}{% endblock %}

{% block ogtags %}
    {{ parent() }}
    <meta property="og:title" content="{{ 'content_stream.headline'|trans }}">
    <meta property="og:description" content="{{ 'content_stream.description'|trans }}">
    <meta property="og:url" content="{{ url('home') }}">
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <section class="content-stream-page">
        <header class="stream-masthead">
            <p class="eyebrow">{{ 'content_stream.tagline'|trans }}</p>
            <h1>{{ 'content_stream.headline'|trans }}</h1>
            <p class="lede">{{ 'content_stream.description'|trans }}</p>
            <div class="stream-journeys">
                <a href="{{ path('newsstand') }}">{{ 'nav.newsstand'|trans }}</a>
                <a href="{{ path('bookshelf') }}">{{ 'nav.bookshelf'|trans }}</a>
                <a href="{{ path('mag_wizard_setup') }}">{{ 'home.newsroom.cta'|trans }}</a>
            </div>
        </header>

        <form action="{{ path('app_search_index') }}" method="get" class="stream-search"
              data-controller="search--nostr-redirect" data-action="submit->search--nostr-redirect#submit">
            <label for="stream-search">{{ 'discover.searchPlaceholder'|trans }}</label>
            <div class="stream-search__controls">
                <input id="stream-search" type="search" name="q" required
                       data-search--nostr-redirect-target="input">
                <button type="submit" class="btn">{{ 'heading.search'|trans }}</button>
            </div>
        </form>

        <div data-controller="content--stream"
             data-content--stream-url-value="{{ path('home_feed_stream') }}"
             data-action="turbo:frame-missing->content--stream#failed turbo:fetch-request-error->content--stream#failed">
            <div class="stream-heading">
                <h2>{{ 'content_stream.latest'|trans }}</h2>
                <button type="button" class="btn btn-secondary"
                        data-action="content--stream#refresh">{{ 'content_stream.refresh'|trans }}</button>
            </div>
            <p role="alert" data-content--stream-target="error" hidden>{{ 'content_stream.error'|trans }}</p>
            <turbo-frame id="home-stream-content" src="{{ path('home_feed_stream', {page: app.request.query.getInt('page', 1)}) }}"
                         data-content--stream-target="frame">
                <p class="home-feed__loading" role="status">{{ 'home_feed.loading'|trans }}</p>
            </turbo-frame>
        </div>
    </section>
{% endblock %}

{% block aside %}
    <section class="context-panel">
        <p class="eyebrow">{{ 'content_stream.context_title'|trans }}</p>
        <p>{{ 'content_stream.context_description'|trans }}</p>
        {% if app.user %}
            <a href="{{ path('reading_nook') }}">{{ 'nav.readingNook'|trans }}</a>
            <a href="{{ path('updates_subscriptions') }}">{{ 'updates.manageSubscriptions'|trans }}</a>
        {% endif %}
        <a href="{{ path('topics') }}">{{ 'nav.topics'|trans }}</a>
    </section>
{% endblock %}
