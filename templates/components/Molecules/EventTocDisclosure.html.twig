<details {{ attributes.defaults({class: 'event-toc-disclosure'}) }}>
    <summary>{{ 'reading_nook.toc.disclosure'|trans({'%title%': title}) }}</summary>
    <turbo-frame id="nook-toc-{{ eventId }}" src="{{ url }}" loading="lazy">
        <a href="{{ url }}">{{ 'reading_nook.toc.load'|trans }}</a>
    </turbo-frame>
</details>
