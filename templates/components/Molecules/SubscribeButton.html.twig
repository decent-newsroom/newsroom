<div {{ attributes }}>
    {% if error is not empty %}
        <p role="alert">{{ error|trans }}</p>
    {% elseif subscribed %}
        <button type="button"
                class="btn btn-outline-secondary"
                title="{{ 'updates.subscription.remove'|trans }}"
                aria-pressed="true"
                data-action="live#action"
                data-live-action-param="toggle">
            {{ 'updates.subscription.subscribed'|trans }}
        </button>
    {% else %}
        <button type="button"
                class="btn btn-outline-primary"
                aria-pressed="false"
                data-action="live#action"
                data-live-action-param="toggle">
            {{ 'updates.subscription.addSubmit'|trans }}
        </button>
    {% endif %}
</div>
