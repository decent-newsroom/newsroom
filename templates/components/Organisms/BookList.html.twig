<div {{ attributes.defaults({class: 'bookshelf-inventory'}) }}>
    {% if books is not empty %}
    {% for item in books %}
        {% set title = item.title|default(item.slug|default('Untitled Book')) %}
        <article class="bookshelf-book">
            {% if item.image %}
                <a class="bookshelf-book__cover" href="{{ path('bookshelf_book', {book: item.slug}) }}" tabindex="-1" aria-hidden="true">
                    <img src="{{ item.image }}" alt="" loading="lazy">
                </a>
            {% else %}
                <div class="bookshelf-book__monogram" aria-hidden="true">
                    {{ title|first|upper }}
                </div>
            {% endif %}

            <div class="bookshelf-book__body">
                <p class="bookshelf-book__format">{{ 'bookshelf.publication.eyebrow'|trans }}</p>
                <h2>
                    <a href="{{ path('bookshelf_book', {book: item.slug}) }}">{{ title }}</a>
                </h2>

                <p class="bookshelf-book__authors">
                    {{ 'bookshelf.published_by'|trans }}
                    <twig:Molecules:UserFromNpub ident="{{ item.pubkey }}" />
                </p>

                {% if item.summary %}
                    <p class="line-clamp-3">{{ item.summary }}</p>
                {% endif %}
            </div>

            <div class="bookshelf-book__actions">
                <a class="bookshelf-book__open btn btn-secondary btn-sm" href="{{ path('bookshelf_book', {book: item.slug}) }}">
                    {{ 'bookshelf.stash.open'|trans }}
                    {{ ux_icon('iconoir:arrow-right', {class: 'icon'}) }}
                </a>
                {% if pubkey and currentUserPubkey and item.pubkey == currentUserPubkey %}
                    <a href="{{ path('mag_wizard_edit', {slug: item.slug}) }}" class="btn btn-secondary btn-sm">Edit</a>
                {% endif %}
            </div>
        </article>
    {% endfor %}
    {% else %}
        <div class="bookshelf-empty">
            {{ ux_icon('iconoir:bookmark-book', {class: 'icon'}) }}
            <p>{{ 'bookshelf.noBooks'|trans }}</p>
        </div>
    {% endif %}
</div>
