{# Embedded event card component #}
{% set eventIdentifier = nevent ?? naddr %}
<div class="embedded-event-card" data-event-id="{{ eventIdentifier }}"{% if event.kind == 9802 %} data-highlight-embed data-turbo-temporary{% endif %}>
    <div class="event-header">
        {% if author %}
            <div class="author-info">
                <strong>{{ author.name ?? 'Anonymous' }}</strong>
            </div>
        {% endif %}
        <div class="event-meta">
            <span class="event-date">{{ event.created_at|date('M j, Y H:i') }}</span>
        </div>
    </div>

    {% include 'event/_generic_event_body.html.twig' with {event: event} only %}

    <div class="event-footer">
        <a href="/e/{{ eventIdentifier }}" class="view-full">View full event</a>
    </div>
</div>
