{# Render a NIP-22 comment as a "callout on top of the referenced item".
   Used in bookmark / expression-result lists where the user is browsing a
   feed of items and wants to see the article that's being commented on,
   not the comment itself. The comment author + text are shown as a small
   strip above the resolved parent/root card.

   For the single-event page (`/e/{nevent}`), use `_kind1111_comment.html.twig`
   instead — that view focuses on the comment itself.
#}
{% set hasRootReference = false %}
{% set rootReferenceType = null %}
{% set rootReferenceValue = null %}
{% set parentE = null %}
{% set parentA = null %}
{% set parentI = null %}
{% set hasParentA = false %}
{% set hasParentE = false %}
{% set hasParentI = false %}
{% set parentARelay = null %}
{% set rootARelay = null %}

{% for tag in event.tags %}
    {% if tag[0] == 'a' and not hasParentA %}
        {% set hasParentA = true %}
        {% set parentA = tag[1] is defined ? tag[1] : null %}
        {% if tag[2] is defined %}{% set parentARelay = tag[2] %}{% endif %}
    {% endif %}
    {% if tag[0] == 'e' and not hasParentE %}
        {% set hasParentE = true %}
        {% set parentE = tag[1] is defined ? tag[1] : null %}
    {% endif %}
    {% if tag[0] == 'i' and not hasParentI %}
        {% set hasParentI = true %}
        {% set parentI = tag[1] is defined ? tag[1] : null %}
    {% endif %}
    {% if tag[0] in ['A', 'E', 'I'] %}
        {% set hasRootReference = true %}
        {% if rootReferenceType is null %}
            {% set rootReferenceType = tag[0]|lower %}
            {% set rootReferenceValue = tag[1] is defined ? tag[1] : null %}
            {% if tag[0] == 'A' and tag[2] is defined %}{% set rootARelay = tag[2] %}{% endif %}
        {% endif %}
    {% endif %}
{% endfor %}

{% set parentReferenceType = hasParentA ? 'a' : (hasParentE ? 'e' : (hasParentI ? 'i' : null)) %}
{% set parentReferenceValue = parentReferenceType == 'a' ? parentA : (parentReferenceType == 'e' ? parentE : parentI) %}

{# Prefer the root scope (uppercase) when present — for an expression listing,
   the article that started the conversation is more useful as the headline
   than an intermediate parent. Fall back to the direct parent. #}
{% set targetType = hasRootReference ? rootReferenceType : parentReferenceType %}
{% set targetValue = hasRootReference ? rootReferenceValue : parentReferenceValue %}
{% set targetRelay = hasRootReference ? rootARelay : parentARelay %}

{# Comment author + text, shown as a small callout above the target. #}
<div class="comment-callout">
    <div class="comment-callout-header">
        <small>
            <twig:Molecules:UserFromNpub :ident="event.pubkey" />
            commented:
        </small>
    </div>
    <blockquote class="comment-callout-body">
        <twig:Atoms:Content :content="event.content" />
    </blockquote>
</div>

{# Resolved target — the actual headline of this list item. #}
{% if (hasRootReference or targetType is not null) and not (targetValue|isValidNostrReferenceValue) %}
    <div class="nostr-placeholder">
        <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
    </div>
{% elseif targetType == 'a' %}
    {% set targetAddress = targetValue|naddrEncodeCoordinateOrNull(targetRelay) %}
    {% if targetAddress is not null %}
        <twig:Molecules:NostrEmbed :bech="targetAddress" type="naddr" />
    {% else %}
        <div class="nostr-placeholder">
            <span class="nostr-placeholder-label">{{ 'event_workspace.target.restricted'|trans }}</span>
        </div>
    {% endif %}
{% elseif targetType == 'e' %}
    <twig:Molecules:NostrEmbed :bech="targetValue|nEncode" type="note" />
{% elseif targetType == 'i' %}
    {% if targetValue|isSafeExternalNostrReference %}
        <div class="comment-callout-external">
            <a href="{{ targetValue }}" target="_blank" rel="noopener noreferrer">{{ targetValue }}</a>
        </div>
    {% else %}
        <div class="comment-callout-external">{{ targetValue }}</div>
    {% endif %}
{% else %}
    {# Standalone comment with no resolvable target — fall back to plain content #}
    <div class="event-content">
        <twig:Atoms:Content :content="event.content" />
    </div>
{% endif %}
