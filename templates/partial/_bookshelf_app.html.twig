<section class="bookshelf-app" aria-labelledby="bookshelf-app-title">
    <div class="bookshelf-app__intro">
        <p class="eyebrow">{{ 'bookshelf.promo.eyebrow'|trans }}</p>
        <h1 id="bookshelf-app-title">{{ 'bookshelf.app.title'|trans }}</h1>
        <p>{{ 'bookshelf.promo.description'|trans }}</p>
    </div>

    <div class="bookshelf-app__downloads">
        <a
            class="bookshelf-app__badge"
            href="https://zapstore.dev/apps/eu.decentnewsroom.bookshelf"
            target="_blank"
            rel="noreferrer"
        >
            <img
                src="{{ asset('images/get-it-on-zapstore.svg') }}"
                alt="{{ 'bookshelf.app.zapstore'|trans }}"
                width="197"
                height="60"
            >
        </a>

        <a
            class="bookshelf-app__release"
            href="https://github.com/decent-newsroom/bookshelf-app/releases"
            target="_blank"
            rel="noreferrer"
        >
            {{ ux_icon('iconoir:github-circle', {class: 'icon'}) }}
            {{ 'bookshelf.app.releases'|trans }}
        </a>
    </div>

    <div class="bookshelf-app__benefits">
        {% for benefit in ['offline', 'comfort', 'highlights', 'privacy'] %}
            <div>
                <h2>{{ ('bookshelf.promo.' ~ benefit ~ '_title')|trans }}</h2>
                <p>{{ ('bookshelf.promo.' ~ benefit ~ '_description')|trans }}</p>
            </div>
        {% endfor %}
    </div>
</section>
