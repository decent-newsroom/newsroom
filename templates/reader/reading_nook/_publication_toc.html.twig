<turbo-frame id="{{ tocPage.frameId|default('nook-toc-' ~ tocPage.eventId) }}">
    {% if tocPage.entries is not empty %}
        <ol class="event-toc-list" start="{{ tocPage.start }}">
            {% for entry in tocPage.entries %}
                {% set reference = entry.reference %}
                {% set discoverable = tocDiscoveryEnabled|default(false) and reference.type.value == 'address'
                    and reference.targetKind in [30040, 30041] and reference.status.value == 'unresolved'
                    and reference.versionEventId is null and not entry.invalidVersionPin
                    and entry.targetResolution != 'available' %}
                <li data-source-tag-position="{{ reference.position }}"
                    {% if discoverable %}
                        {% set discoveryParams = {eventId: tocPage.eventId, position: reference.position, page: tocPage.page} %}
                        {% if tocPage.occurrenceId is not null %}
                            {% set discoveryParams = discoveryParams|merge({
                                path: tocPage.ancestorPath|join(','), occurrence: tocPage.occurrenceId,
                                signature: tocPage.discoverySignature
                            }) %}
                        {% endif %}
                        data-controller="content--toc-discovery"
                        data-content--toc-discovery-url-value="{{ path('reading_nook_publication_toc_discovery', discoveryParams) }}"
                        data-content--toc-discovery-token-value="{{ csrf_token('toc-discovery:' ~ tocPage.eventId ~ ':' ~ reference.position) }}"
                        data-content--toc-discovery-loading-value="{{ 'reading_nook.toc.discovery.loading'|trans }}"
                        data-content--toc-discovery-failed-value="{{ 'reading_nook.toc.discovery.failed'|trans }}"
                        data-content--toc-discovery-limited-value="{{ 'reading_nook.toc.discovery.limited'|trans }}"
                        data-content--toc-discovery-retry-value="{{ 'reading_nook.toc.discovery.retry'|trans }}"
                        data-content--toc-discovery-available-value="{{ 'reading_nook.toc.discovery.completed'|trans }}"
                        data-content--toc-discovery-unavailable-value="{{ 'reading_nook.toc.discovery.pinned_unavailable'|trans }}"
                    {% endif %}
                >
                    <div data-content--toc-discovery-target="panel">
                        {% include 'reader/reading_nook/_publication_toc_entry.html.twig' %}
                    </div>
                    {% if discoverable %}
                        <span role="status" aria-live="polite" data-content--toc-discovery-target="status"></span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% else %}
        <p>{{ 'reading_nook.toc.empty'|trans }}</p>
    {% endif %}
    <nav class="event-toc-pagination" aria-label="{{ 'reading_nook.toc.pagination'|trans }}">
        {% set previousParams = {eventId: tocPage.eventId, page: tocPage.page - 1} %}
        {% set nextParams = {eventId: tocPage.eventId, page: tocPage.page + 1} %}
        {% if tocPage.occurrenceId|default(null) is not null %}
            {% set previousParams = previousParams|merge({
                path: tocPage.ancestorPath|join(','),
                occurrence: tocPage.occurrenceId,
                coordinate: tocPage.coordinate,
                signature: tocPage.pageSignatures.previous
            }) %}
            {% set nextParams = nextParams|merge({
                path: tocPage.ancestorPath|join(','),
                occurrence: tocPage.occurrenceId,
                coordinate: tocPage.coordinate,
                signature: tocPage.pageSignatures.next
            }) %}
        {% endif %}
        {% if tocPage.hasPrevious %}
            <a rel="prev" href="{{ path(tocPage.routeName|default('reading_nook_publication_toc'), previousParams) }}">{{ 'reading_nook.toc.previous'|trans }}</a>
        {% endif %}
        <span>{{ 'reading_nook.toc.page'|trans({'%page%': tocPage.page}) }}</span>
        {% if tocPage.hasNext %}
            <a rel="next" href="{{ path(tocPage.routeName|default('reading_nook_publication_toc'), nextParams) }}">{{ 'reading_nook.toc.next'|trans }}</a>
        {% endif %}
    </nav>
</turbo-frame>
