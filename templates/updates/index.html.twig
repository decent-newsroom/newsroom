{% extends 'reading-nook-layout.html.twig' %}
{% block title %}{{ 'updates.pageTitle'|trans }}{% endblock %}
{% block stylesheets %}{{ parent() }}<meta name="turbo-cache-control" content="no-cache">{% endblock %}
{% block body %}
<div class="w-container py-4"
     data-controller="ui--updates-stream"
     data-ui--updates-stream-items-url-value="{{ app.request.query.has('before') ? '' : path('subscription_feed_items') }}"
     data-ui--updates-stream-error-value="{{ 'subscription_feed.refresh_error'|trans }}">

    <twig:Atoms:PageHeading
        heading="{{ 'updates.pageTitle'|trans }}"
        tagline="{{ 'updates.tagline'|trans }}" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a class="btn mb-3" href="{{ path('updates_subscriptions') }}">{{ 'updates.manageSubscriptions'|trans }}</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notice {{ label }}">{{ message|trans }}</div>
        {% endfor %}
    {% endfor %}

    <p>{{ 'subscription_feed.local_notice'|trans }}</p>
    <div data-ui--updates-stream-target="list">
        {% include 'updates/_feed.html.twig' %}
    </div>
</div>
{% endblock %}
