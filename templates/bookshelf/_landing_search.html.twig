<section
    class="bookshelf-web"
    aria-labelledby="bookshelf-web-heading"
    {% if app.user %}
        data-controller="ui--bookshelf-directory"
        data-ui--bookshelf-directory-publish-url-value="{{ path('bookshelf_directory_publish') }}"
        data-ui--bookshelf-directory-csrf-token-value="{{ csrf_token('bookshelf_directory') }}"
        data-ui--bookshelf-directory-directory-identifier-value="{{ directoryIdentifier }}"
        data-ui--bookshelf-directory-initial-tags-value="{{ directoryTags|json_encode|e('html_attr') }}"
        data-ui--bookshelf-directory-added-message-value="{{ 'bookshelf.saved_to_my_books'|trans|e('html_attr') }}"
        data-ui--bookshelf-directory-removed-message-value="{{ 'bookshelf.removed_from_my_books'|trans|e('html_attr') }}"
        data-ui--bookshelf-directory-publish-failed-message-value="{{ 'bookshelf.directory_publish_failed'|trans|e('html_attr') }}"
        data-ui--bookshelf-directory-signer-unavailable-message-value="{{ 'bookshelf.directory_signer_unavailable'|trans|e('html_attr') }}"
        data-ui--bookshelf-directory-limit-reached-message-value="{{ 'bookshelf.directory_limit_reached'|trans({'%limit%': 500})|e('html_attr') }}"
    {% endif %}
>
    <h2 id="bookshelf-web-heading">{{ 'bookshelf.promo.web_title'|trans }}</h2>
    <form class="bookshelf-search" action="{{ path('bookshelf') }}#bookshelf-web-heading" method="get">
        <label for="bookshelf-query">{{ 'bookshelf.search_label'|trans }}</label>
        <div class="bookshelf-search__control">
            <input id="bookshelf-query" type="search" name="q" value="{{ query }}" minlength="2" maxlength="120"
                   placeholder="{{ 'bookshelf.search_placeholder'|trans }}" autocomplete="off">
            <button class="icon-button" type="submit" aria-label="{{ 'bookshelf.search_action'|trans }}">
                {{ ux_icon('iconoir:search', {class: 'icon'}) }}
            </button>
        </div>
    </form>

    {% if not available %}
        <div class="bookshelf-notice" role="status">
            <h3>{{ 'bookshelf.unavailable_title'|trans }}</h3>
            <p>{{ 'bookshelf.unavailable_description'|trans }}</p>
        </div>
    {% elseif queryTooShort %}
        <p class="bookshelf-notice" role="status">{{ 'bookshelf.query_too_short'|trans }}</p>
    {% elseif searched %}
        <div class="bookshelf-results">
            <p>{{ 'bookshelf.results'|trans({'%count%': books|length, '%query%': query}) }}</p>
            <a href="{{ path('bookshelf') }}#bookshelf-web-heading">{{ 'bookshelf.clear_search'|trans }}</a>
        </div>
        <div class="bookshelf-inventory">
            {% for book in books %}
                <article class="bookshelf-book">
                    {% if book.coverImage %}
                        <a class="bookshelf-book__cover" href="{{ path('bookshelf_read', {id: book.id, q: query}) }}" tabindex="-1" aria-hidden="true">
                            <img src="{{ book.coverImage }}" alt="" loading="lazy">
                        </a>
                    {% else %}
                        <div class="bookshelf-book__monogram" aria-hidden="true">{{ book.title|first|upper }}</div>
                    {% endif %}
                    <div class="bookshelf-book__body">
                        <p class="bookshelf-book__format">{{ book.type|upper }}</p>
                        <h3><a href="{{ path('bookshelf_read', {id: book.id, q: query}) }}">{{ book.title }}</a></h3>
                        {% if book.authors is not empty %}
                            <p class="bookshelf-book__authors">{{ 'bookshelf.by_author'|trans({'%author%': book.authors|join(', ')}) }}</p>
                        {% endif %}
                        {% if book.summary %}<p>{{ book.summary }}</p>{% endif %}
                        <div class="bookshelf-book__meta">
                            <span>{{ 'bookshelf.chapter_count'|trans({'%count%': book.chapterCount}) }}</span>
                            {% if book.language %}<span>{{ book.language|upper }}</span>{% endif %}
                            {% if book.releaseDate %}<span>{{ book.releaseDate }}</span>{% endif %}
                            {% if book.version %}<span>{{ book.version }}</span>{% endif %}
                        </div>
                        {% if book.topics is not empty %}
                            <div class="bookshelf-book__topics">
                                {% for topic in book.topics|slice(0, 5) %}<span>#{{ topic }}</span>{% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="bookshelf-book__actions">
                        <a class="bookshelf-book__open btn btn-secondary btn-sm" href="{{ path('bookshelf_read', {id: book.id, q: query}) }}">
                            {{ 'bookshelf.read_book'|trans }}
                            {{ ux_icon('iconoir:arrow-right', {class: 'icon'}) }}
                        </a>
                        {% if app.user and book.coordinate is defined %}
                            <button type="button" class="bookshelf-directory-action btn btn-secondary btn-sm"
                                    data-ui--bookshelf-directory-target="toggle" data-action="click->ui--bookshelf-directory#toggle"
                                    data-ui--bookshelf-directory-coordinate-param="{{ book.coordinate }}"
                                    data-ui--bookshelf-directory-relay-param="{{ book.relay|default('') }}"
                                    data-ui--bookshelf-directory-event-id-param="{{ book.id }}"
                                    data-label-add="{{ 'bookshelf.add_to_my_books'|trans|e('html_attr') }}"
                                    data-label-remove="{{ 'bookshelf.remove_from_my_books'|trans|e('html_attr') }}"
                                    aria-pressed="{{ book.coordinate in directoryCoordinates ? 'true' : 'false' }}">
                                {{ book.coordinate in directoryCoordinates ? 'bookshelf.remove_from_my_books'|trans : 'bookshelf.add_to_my_books'|trans }}
                            </button>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <div class="bookshelf-empty">
                    <h3>{{ 'bookshelf.no_results_title'|trans }}</h3>
                    <p>{{ 'bookshelf.no_results_description'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
