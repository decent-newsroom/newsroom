# Standalone MCP service configuration.
# Copy to .env and fill in real values, or provide these as environment
# variables (recommended in Docker).

# Base URL of the newsroom internal read-only API (reachable on the internal
# Docker network). No trailing slash.
NEWSROOM_INTERNAL_API_BASE=http://php

# Shared secret sent as X-Internal-Token to the newsroom internal API.
# Must match INTERNAL_API_TOKEN in the newsroom app.
INTERNAL_API_TOKEN=change-me-internal-api-token

# Bearer token required from MCP clients over the HTTP transport.
# Enforced at the reverse proxy (Caddy) in front of this service.
MCP_AUTH_TOKEN=change-me-mcp-auth-token

# HTTP transport bind address/port (MCP protocol prohibits 0.0.0.0).
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=9000
