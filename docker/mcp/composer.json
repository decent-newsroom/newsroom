{
    "name": "decent-newsroom/mcp",
    "type": "project",
    "license": "MIT",
    "description": "Standalone Model Context Protocol server exposing Decent Newsroom articles (read-only)",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php-mcp/server": "^3.1",
        "symfony/http-client": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "DecentNewsroom\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecentNewsroom\\Mcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
