{
  "swagger": "2.0",
  "info": {
    "title": "Decent Newsroom Books API",
    "version": "1.0.0",
    "description": "Public read-only API for Nostr publication events. It reads the configured external Elasticsearch alias only; it does not publish, delete, or use relay/database fallbacks."
  },
  "basePath": "/books/api",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "consumes": [
    "application/json"
  ],
  "tags": [
    {
      "name": "Events"
    },
    {
      "name": "Publications"
    }
  ],
  "paths": {
    "/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Query Nostr events with a URL NIP-01 filter",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int64",
            "description": "Inclusive Unix timestamp lower bound."
          },
          {
            "name": "until",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int64",
            "description": "Inclusive Unix timestamp upper bound."
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "ids",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{1,64}$"
            },
            "collectionFormat": "multi",
            "description": "Repeat the key for each ID."
          },
          {
            "name": "authors",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{1,64}$"
            },
            "collectionFormat": "multi",
            "description": "Repeat the key for each pubkey."
          },
          {
            "name": "kinds",
            "in": "query",
            "type": "array",
            "items": {
              "type": "integer"
            },
            "collectionFormat": "multi",
            "description": "Repeat the key for each kind."
          },
          {
            "name": "#x",
            "in": "query",
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi",
            "description": "A tag filter key exactly formed as # plus one ASCII letter. Replace x with the case-sensitive tag name, for example #T or #t. Repeat the key for each value."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching events.",
            "schema": {
              "$ref": "#/definitions/PubEventList"
            }
          },
          "400": {
            "$ref": "#/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/events/filter": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Query Nostr events with a JSON NIP-01 filter",
        "parameters": [
          {
            "name": "filter",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Nip01FilterRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching events.",
            "schema": {
              "$ref": "#/definitions/PubEventList"
            }
          },
          "400": {
            "$ref": "#/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/events/{eventId}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Retrieve an event by its exact Nostr event ID",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        ],
        "responses": {
          "200": {
            "description": "The event.",
            "schema": {
              "$ref": "#/definitions/PubEvent"
            }
          },
          "400": {
            "$ref": "#/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/responses/EventNotFound"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/publications/search": {
      "post": {
        "tags": [
          "Publications"
        ],
        "summary": "Search kind 30040 publication indexes",
        "parameters": [
          {
            "name": "search",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PublicationSearchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching publication indexes.",
            "schema": {
              "$ref": "#/definitions/PubEventList"
            }
          },
          "400": {
            "$ref": "#/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/publications/recommendations": {
      "post": {
        "tags": [
          "Publications"
        ],
        "summary": "Recommend kind 30040 publications from a seed event",
        "description": "Uses native Elasticsearch subject similarity and exact author matches. Excludes the seed and supplied IDs, deduplicates publication coordinates, and returns relevance-ranked signed events. Results may be fewer than the requested limit or empty. No language filter, personalization, index writes, or database/relay fallback.",
        "parameters": [
          {
            "name": "recommendation",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PublicationRecommendationRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recommended publication indexes, ordered by relevance descending and event ID ascending before coordinate deduplication. May be empty.",
            "schema": {
              "$ref": "#/definitions/PubEventList"
            }
          },
          "400": {
            "description": "Invalid request or seed event is not kind 30040.",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "404": {
            "$ref": "#/responses/EventNotFound"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/publications/sections/search": {
      "post": {
        "tags": [
          "Publications"
        ],
        "summary": "Search kind 30041 publication sections",
        "parameters": [
          {
            "name": "search",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SectionSearchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching publication sections.",
            "schema": {
              "$ref": "#/definitions/PubEventList"
            }
          },
          "400": {
            "$ref": "#/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "definitions": {
    "PubEvent": {
      "type": "object",
      "required": [
        "content",
        "created_at",
        "id",
        "kind",
        "pubkey",
        "sig",
        "tags"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "kind": {
          "type": "integer"
        },
        "pubkey": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sig": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "PubEventList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PubEvent"
      }
    },
    "Nip01FilterRequest": {
      "type": "object",
      "required": [
        "limit"
      ],
      "description": "Tag filters use additional property names exactly shaped # plus one ASCII letter and are case-sensitive. Multi-letter tag keys are rejected.",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{1,64}$"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{1,64}$"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "since": {
          "type": "integer",
          "format": "int64"
        },
        "until": {
          "type": "integer",
          "format": "int64"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "PublicationSearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "author": {
          "type": "string",
          "maxLength": 160
        },
        "language": {
          "type": "string",
          "maxLength": 32
        },
        "subject": {
          "type": "string",
          "maxLength": 160
        },
        "d": {
          "type": "string",
          "maxLength": 160
        },
        "identifier": {
          "type": "string",
          "maxLength": 512
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "PublicationRecommendationRequest": {
      "type": "object",
      "required": [
        "seed_event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "seed_event_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "Full Nostr event ID of an indexed kind 30040 publication; normalized to lowercase."
        },
        "exclude_ids": {
          "type": "array",
          "description": "Full event IDs to exclude. At most 100 supplied items before deduplication. Normalized to lowercase; duplicates are accepted and deduplicated.",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      }
    },
    "SectionSearchRequest": {
      "type": "object",
      "required": [
        "q"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "ApiError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "responses": {
    "InvalidRequest": {
      "description": "Invalid request.",
      "schema": {
        "$ref": "#/definitions/ApiError"
      }
    },
    "EventNotFound": {
      "description": "No event with that ID exists.",
      "schema": {
        "$ref": "#/definitions/ApiError"
      }
    },
    "ServiceUnavailable": {
      "description": "The configured Books Elasticsearch alias is unavailable.",
      "schema": {
        "$ref": "#/definitions/ApiError"
      }
    }
  }
}
